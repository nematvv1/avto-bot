# Telegram BotFather'dan olingan token
BOT_TOKEN=123456789:AAExampleTokenReplaceWithReal

# Kanal username yoki ID (bot kanalda ADMIN bo'lishi shart!)
# Username bo'lsa: @mening_kanalim
# ID bo'lsa: -1001234567890
CHANNEL_ID=@mening_kanalim

# Sizning Telegram ID raqamingiz (bir nechta bo'lsa vergul bilan: 111,222,333)
# ID ni bilish uchun @userinfobot ga /start yozing
ADMIN_IDS=111111111,222222222

# OpenAI platform.openai.com dan olingan API kalit
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# Modellar (o'zgartirish shart emas)
TEXT_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2

# Ma'lumotlar bazasi fayli nomi
DB_PATH=bot_database.db

# Generatsiya qilingan (va brendlangan) rasmlar saqlanadigan papka. Render kabi platformalarda
# bu qiymatni doimiy diskka (persistent disk) yo'naltiring (masalan /var/data/generated_images),
# aks holda har deploy'da rasmlar o'chib ketadi.
IMAGES_DIR=generated_images

# Kanalingiz mavzusi - AI shu mavzuga mos kontent generatsiya qiladi
CHANNEL_TOPIC=IT, dasturlash va texnologiyalar

# Kanalingizning yagona vizual uslubi (brend). Barcha postdagi rasmlar shu uslubda chizib beriladi,
# shunda kanalingiz vizual jihatdan bir xil, tanish "brend"ga ega bo'ladi.
# Ingliz tilida yozing - AI shunda yaxshiroq tushunadi. O'zingizga moslab o'zgartiring:
IMAGE_STYLE=modern flat-design digital illustration, clean minimalist tech aesthetic, soft gradient background (deep blue to purple), subtle geometric shapes, high contrast, professional and polished, no text or letters in the image

# Rasm o'lchami: 1536x1024 (gorizontal - Telegram feedda eng chiroyli ko'rinadi), 1024x1024 (kvadrat), 1024x1536 (vertikal)
IMAGE_SIZE=1536x1024

# --- Kanal brendi (logo + nom) ---
# Har bir generatsiya qilingan rasmga logotip va nom avtomatik joylansinmi
ADD_BRANDING=true

# Kanal nomi (rasmda ko'rinadi)
BRAND_NAME=Kanal Nomi

# Logotip fayli - assets/logo.png joyiga o'z logotipingizni qo'ying
LOGO_PATH=assets/logo.png

# Brend rangi (ajratuvchi chiziq uchun, logotipingizga mos HEX rang)
BRAND_ACCENT_COLOR=#2033E9

# --- Qo'shimcha sozlamalar ---
# Vaqt zonasi (server vaqti bilan mos bo'lishi shart!)
# Ro'yxat: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Tashkent

# So'rovnomada bir nechta javob tanlash (true = mumkin, false = faqat bitta)
POLL_ALLOWS_MULTIPLE=false

# Necha kundan eski rasm fayllarini avtomatik o'chirish (0 = o'chirmaslik)
IMAGE_CLEANUP_DAYS=7

# Har bir "post" turidagi kontent oxiriga avtomatik qo'shiladigan kontakt bloki
# (ro'yxatdan o'tish manzili, telefon raqamlar va h.k.). Bo'sh qoldirilsa, qo'shilmaydi.
# Qatorlarni "\n" bilan ajrating.
POST_CONTACT_FOOTER=📌 Ro'yxatdan o'tish: @mening_botim\n\n📞 +998901234567

# --- Joylashda xatolik bo'lganda qayta urinish ---
# Necha marta urinilgach, post "failed" deb belgilanadi
SCHEDULE_MAX_RETRIES=5
# Urinishlar orasidagi boshlang'ich kutish vaqti (daqiqa) — har urinishda 2 barobar oshadi
SCHEDULE_RETRY_BASE_MINUTES=2
# Urinishlar orasidagi maksimal kutish vaqti (daqiqa)
SCHEDULE_RETRY_MAX_MINUTES=60

# --- AI generatsiya uchun rate-limit ---
# Bir soat ichida (har bir admin uchun) nechta kontent generatsiya qilish mumkinligi
MAX_GENERATIONS_PER_HOUR=20

# Rejalashtirilganlar ro'yxatida bir sahifada nechta element ko'rsatiladi
SCHEDULED_PAGE_SIZE=8
